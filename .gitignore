# データベースファイル
shirushi.db
shirushi.db.backup-*
# WAL モードで作られる補助ファイル（-wal: 書き込みログ / -shm: 共有メモリ）
shirushi.db-wal
shirushi.db-shm

# ビルド済みバイナリ
shirushi

# リリース用ビルド成果物
dist/

# Shioriの参照用クローン（サブモジュールではないため除外）
_refs/shiori/

# テスト出力（go test -coverprofile で生成）
coverage.out

# Playwright スナップショット・スクリーンショット（一時ファイル）
.playwright-cli/
*.png
*.webm
