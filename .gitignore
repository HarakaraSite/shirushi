# データベースファイル
shirushi.db
shirushi.db.backup-*
# WAL モードで作られる補助ファイル（-wal: 書き込みログ / -shm: 共有メモリ）
shirushi.db-wal
shirushi.db-shm

# ビルド済みバイナリ
shirushi

# リリース用ビルド成果物
dist/

# Shioriの参照用クローン（サブモジュールではないため除外）
_refs/shiori/

# テスト出力（go test -coverprofile で生成）
coverage.out

# Claude Code のローカル起動設定（パスワード等を含むため除外）
.claude/launch.json

# Piが生成するローカル実行履歴
/.pi/agent/runs/

# Node.jsの開発用依存
node_modules/

# Playwright Testの一時出力
playwright-report/
test-results/
blob-report/

# テストで生成される一時的なスクリーンショット・動画
*.png
*.webm
# ドキュメント画像と視覚回帰テストの基準画像は除外しない
!docs/*.png
!e2e/**/*-snapshots/*.png
